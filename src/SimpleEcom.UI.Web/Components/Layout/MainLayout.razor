@inherits LayoutComponentBase
@inject TimeProvider Clock

<a class="skip-link" href="#main">Saltar al contenido</a>

<header class="site-header">
    <div class="container site-header__inner">
        <a class="brand" href="">
            <span class="brand__mark" aria-hidden="true">S</span>
            <span class="brand__name">SimpleEcom</span>
        </a>

        <form class="site-search" method="get" action="products" role="search" data-enhance>
            <label for="site-search-input" class="visually-hidden">Buscar productos</label>
            <input id="site-search-input" name="q" type="search" class="form-control" placeholder="¿Qué estás buscando?" />
            <button type="submit" class="site-search__button" aria-label="Buscar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
                </svg>
            </button>
        </form>

        <nav class="site-nav" aria-label="Principal">
            <NavLink class="site-nav__link" href="" Match="NavLinkMatch.All">Inicio</NavLink>
            <NavLink class="site-nav__link" href="products">Catálogo</NavLink>
        </nav>
    </div>
</header>

<main id="main" class="container site-main">
    @Body
</main>

<footer class="site-footer">
    <div class="container site-footer__inner">
        <div>
            <span class="brand__name">SimpleEcom</span>
            <p class="site-footer__tagline">Básicos bien hechos, a precios claros.</p>
        </div>
        <nav class="site-footer__nav" aria-label="Pie de página">
            <a href="">Inicio</a>
            <a href="products">Catálogo</a>
            <a href="products?available=true">Disponibles ahora</a>
        </nav>
        <p class="site-footer__legal">&copy; @Clock.GetLocalNow().Year SimpleEcom</p>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Se ha producido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss" aria-label="Cerrar">🗙</span>
</div>
