@page "/products/{Id:guid}"
@inject ProductDetailViewModel Vm
@inject NavigationManager Navigation
@implements IDisposable

@* Sin streaming a propósito: el servidor espera a la Api y envía el HTML completo (título, precio, descripción,
   datos estructurados) en la primera respuesta, con 404 real si el producto no existe. *@

<PageTitle>@(Vm.Product?.Name ?? "Producto") · SimpleEcom</PageTitle>

@if (Vm.Product is { } seoProduct)
{
    <SeoMeta Title="@($"{seoProduct.Name} · SimpleEcom")"
             Description="@CatalogSeo.ProductDescription(seoProduct)"
             CanonicalPath="@CanonicalPath"
             OgType="product"
             JsonLd="@CatalogSeo.ProductJsonLd(seoProduct, Navigation.ToAbsoluteUri(CanonicalPath).ToString())" />
}
else
{
    <SeoMeta Title="Producto no disponible · SimpleEcom"
             Description="Este producto no está disponible en SimpleEcom. Descubre el resto del catálogo."
             CanonicalPath="@CanonicalPath"
             NoIndex="true" />
}

<nav aria-label="Ruta de navegación">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="">Inicio</a></li>
        <li class="breadcrumb-item"><a href="products">Catálogo</a></li>
        @if (Vm.Product is not null)
        {
            <li class="breadcrumb-item active" aria-current="page">@Vm.Product.Name</li>
        }
    </ol>
</nav>

@* Producto inexistente o inactivo: Navigation.NotFound() (en @code) pinta Pages/NotFound con 404 en lugar de esta página. *@
@if (Vm.ErrorMessage is not null)
{
    <div class="alert alert-warning" role="alert">
        <strong>No podemos mostrar el producto ahora mismo.</strong> Inténtalo de nuevo en unos minutos.
    </div>
}
else if (Vm.Product is not { } product)
{
    <div class="product-detail" aria-busy="true">
        <div class="product-image product-image--large skeleton"></div>
        <div>
            <div class="skeleton skeleton-line skeleton-line--lg w-75"></div>
            <div class="skeleton skeleton-line w-25"></div>
            <div class="skeleton skeleton-line w-100 mt-4"></div>
            <div class="skeleton skeleton-line w-75"></div>
        </div>
        <span class="visually-hidden" role="status">Cargando producto…</span>
    </div>
}
else
{
    <div class="product-detail">
        <ProductImage Product="product" CssClass="product-image--large" />

        <div class="product-detail__info">
            <h1 class="product-detail__name">@product.Name</h1>
            <p class="product-detail__sku">Ref. @product.Sku</p>

            <p class="product-detail__price">@CatalogDisplay.FormatPrice(product.Price, product.Currency)</p>
            <StockBadge Stock="product.Stock" />

            @if (!string.IsNullOrWhiteSpace(product.Description))
            {
                <p class="product-detail__description">@product.Description</p>
            }

            <div class="product-detail__actions">
                @* El carrito llegará con el contexto Carts de la Api; mientras tanto el botón queda deshabilitado. *@
                <button type="button" class="btn btn-dark btn-lg" disabled aria-describedby="cart-hint">
                    @(Vm.CanBuy ? "Añadir al carrito" : "Agotado")
                </button>
                <p id="cart-hint" class="product-detail__hint">
                    @(Vm.CanBuy ? "La compra online estará disponible muy pronto." : "Vuelve pronto: reponemos stock con frecuencia.")
                </p>
            </div>
        </div>
    </div>

    @if (Vm.Related.Count > 0)
    {
        <section class="section" aria-labelledby="related-title">
            <div class="section__header">
                <h2 id="related-title" class="section__title">También te puede interesar</h2>
            </div>
            <ProductGrid Products="Vm.Related" />
        </section>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string CanonicalPath => $"products/{Id}";

    protected override void OnInitialized() => Vm.StateChanged += StateHasChanged;

    // OnParametersSet (no OnInitialized): al navegar de una ficha a otra se reutiliza el componente y cambia el Id.
    protected override async Task OnParametersSetAsync()
    {
        await Vm.LoadAsync(Id);

        if (Vm.IsNotFound)
        {
            // Única vía soportada para un 404 en SSR: un StatusCode = 404 manual hace que Blazor descarte el HTML
            // (respuesta vacía, o conexión cortada si BranchBar ya empezó el streaming). Pinta NotFoundPage del Router.
            Navigation.NotFound();
        }
        else if (Vm.ErrorMessage is not null)
        {
            HttpStatus.SetUnavailable(HttpContext);
        }
    }

    public void Dispose() => Vm.StateChanged -= StateHasChanged;
}
