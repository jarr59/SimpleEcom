@page "/products"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ProductListViewModel Vm
@implements IDisposable

<PageTitle>Productos · SimpleEcom Admin</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Productos</h1>
    <a class="btn btn-primary @(Vm.IsAnyBusy ? "disabled" : null)"
       aria-disabled="@(Vm.IsAnyBusy ? "true" : null)"
       href="products/new">+ Nuevo producto</a>
</div>

@if (Vm.SuccessMessage is not null)
{
    <div class="alert alert-success alert-dismissible" role="status">
        @Vm.SuccessMessage
        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="Vm.DismissSuccess"></button>
    </div>
}

@if (Vm.ErrorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @Vm.ErrorMessage
        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="Vm.DismissError"></button>
    </div>
}

<form class="row g-2 align-items-end mb-3" @onsubmit="Vm.LoadAsync" @onsubmit:preventDefault>
    <div class="col-sm-6 col-lg-4">
        <label for="search" class="form-label">Buscar</label>
        <input id="search" class="form-control" placeholder="Nombre o SKU" disabled="@Vm.IsAnyBusy" @bind="Vm.Search" />
    </div>
    <div class="col-sm-4 col-lg-3">
        <label for="status" class="form-label">Estado</label>
        <select id="status" class="form-select" disabled="@Vm.IsAnyBusy" @bind="Vm.StatusFilter" @bind:after="Vm.LoadAsync">
            <option value="">Todos</option>
            <option value="true">Activos</option>
            <option value="false">Inactivos</option>
        </select>
    </div>
    <div class="col-auto">
        <BusyButton Type="submit" CssClass="btn-outline-primary" Busy="Vm.Load.IsBusy" BusyText="Buscando…" Disabled="Vm.RowAction.IsBusy">
            Buscar
        </BusyButton>
    </div>
</form>

@if (Vm.Products is null)
{
    <div class="d-flex align-items-center gap-2 text-muted" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Cargando productos…
    </div>
}
else if (Vm.Products.Count == 0)
{
    <div class="text-center text-muted border rounded p-5">
        <p class="mb-2">No hay productos que coincidan con los filtros.</p>
        <a href="products/new">Crear el primer producto</a>
    </div>
}
else
{
    @* Al recargar con la tabla ya visible se atenúa y se bloquea en lugar de vaciarla. *@
    <div class="table-responsive @(Vm.Load.IsBusy ? "opacity-50 pe-none" : null)" aria-busy="@(Vm.Load.IsBusy ? "true" : null)">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">SKU</th>
                    <th scope="col">Nombre</th>
                    <th scope="col" class="text-end">Precio</th>
                    <th scope="col" class="text-end">Stock</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Vm.Products)
                {
                    var rowBusy = Vm.RowAction.IsBusy && Vm.BusyProductId == product.Id;
                    <tr @key="product.Id" class="@(rowBusy ? "table-active" : null)">
                        <td><code>@product.Sku</code></td>
                        <td>@product.Name</td>
                        <td class="text-end text-nowrap">@product.Price.ToString("N2") @product.Currency</td>
                        <td class="text-end">
                            <span class="@(product.Stock == 0 ? "badge text-bg-danger" : "")">@product.Stock</span>
                        </td>
                        <td>
                            <span class="badge @(product.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(product.IsActive ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary @(Vm.IsAnyBusy ? "disabled" : null)"
                               aria-disabled="@(Vm.IsAnyBusy ? "true" : null)"
                               tabindex="@(Vm.IsAnyBusy ? -1 : 0)"
                               href="products/@product.Id/edit">Editar</a>
                            <BusyButton CssClass="btn-sm btn-outline-secondary"
                                        Busy="Vm.IsRowBusy(product.Id, ProductRowAction.Toggle)"
                                        BusyText="@(product.IsActive ? "Desactivando…" : "Activando…")"
                                        Disabled="Vm.IsAnyBusy"
                                        OnClick="() => Vm.ToggleActiveAsync(product)">
                                @(product.IsActive ? "Desactivar" : "Activar")
                            </BusyButton>
                            <BusyButton CssClass="btn-sm btn-outline-danger"
                                        Busy="Vm.IsRowBusy(product.Id, ProductRowAction.Delete)"
                                        BusyText="Eliminando…"
                                        Disabled="Vm.IsAnyBusy"
                                        OnClick="() => Vm.RequestDelete(product)">
                                Eliminar
                            </BusyButton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">@Vm.Products.Count producto(s)</p>
}

@if (Vm.ProductToDelete is { } toDelete)
{
    var deleting = Vm.IsRowBusy(toDelete.Id, ProductRowAction.Delete);
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="delete-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 id="delete-title" class="modal-title h5">Eliminar producto</h2>
                    <button type="button" class="btn-close" aria-label="Cerrar" disabled="@deleting" @onclick="Vm.CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1">¿Seguro que quieres eliminar <strong>@toDelete.Name</strong> (<code>@toDelete.Sku</code>)?</p>
                    <p class="text-muted small mb-0">Esta acción no se puede deshacer. Si solo quieres ocultarlo de la tienda, desactívalo.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" disabled="@deleting" @onclick="Vm.CancelDelete">Cancelar</button>
                    <BusyButton CssClass="btn-danger" Busy="deleting" BusyText="Eliminando…" OnClick="Vm.ConfirmDeleteAsync">Eliminar</BusyButton>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Vm.StateChanged += StateHasChanged;
        Vm.ShowStatus(Status);
        await Vm.LoadAsync();
    }

    public void Dispose() => Vm.StateChanged -= StateHasChanged;
}
