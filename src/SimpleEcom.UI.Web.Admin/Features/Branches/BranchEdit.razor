@page "/branches/{Id:guid}/edit"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject BranchEditorViewModel Vm
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Editar sucursal · SimpleEcom Admin</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="branches">Sucursales</a></li>
        <li class="breadcrumb-item active" aria-current="page">Editar</li>
    </ol>
</nav>

@if (Vm.Load.IsBusy)
{
    <div class="d-flex align-items-center gap-2 text-muted" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Cargando sucursal…
    </div>
}
else if (!Vm.IsLoaded)
{
    <div class="alert alert-warning" role="alert">@Vm.Load.Error</div>
    <a class="btn btn-outline-secondary" href="branches">Volver al listado</a>
}
else
{
    <div class="d-flex align-items-center gap-3 mb-4">
        <h1 class="h3 mb-0">@Vm.Form.Name</h1>
        <span class="badge @(Vm.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Vm.IsActive ? "Activa" : "Inactiva")</span>
    </div>

    <BranchForm Vm="Vm" OnValidSubmit="SaveAsync" />
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    protected override void OnInitialized() => Vm.StateChanged += StateHasChanged;

    protected override Task OnParametersSetAsync() =>
        Vm.BranchId == Id ? Task.CompletedTask : Vm.LoadAsync(Id);

    private async Task SaveAsync()
    {
        if (await Vm.SaveAsync())
        {
            Navigation.NavigateTo("branches?status=updated");
        }
    }

    public void Dispose() => Vm.StateChanged -= StateHasChanged;
}
